{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-local",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port", "8085"],
      "port": 8085
    },
    {
      "name": "app-emuladores",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8086",
        "--dart-define=USAR_EMULADORES=true"
      ],
      "port": 8086
    }
  ]
}
