rules_version = '2';

// Reglas de acceso de Firestore.
//
// Postura: DENEGAR POR DEFECTO. Ninguna coleccion es legible ni escribible
// salvo por concesion explicita.
//
// **Aqui vive la puerta de consentimiento** (decision D1 de la feature 004).
// No en la pantalla: una puerta que solo comprueba el cliente no es una
// puerta, es una cortesia. El cliente la comprueba tambien, para no enviar lo
// que va a rebotar y para explicarselo al nadador, pero quien la hace cumplir
// es este archivo.
//
// La decision de quien puede que esta escrita aqui esta escrita tambien en
// `lib/dominio/cuentas/permisos.dart`, del lado del cliente. Que las dos
// coincidan lo vigila `test/acceso/casos.json`, que las dos suites recorren
// (garantia A10).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Quien eres ----------------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    // El rol viaja dentro del token, firmado por el Admin SDK. Un cliente no
    // puede alterarlo (decision D2). Si esta cadena cambia, cambia tambien en
    // `Rol.clave` de lib/dominio/cuentas/cuenta.dart el mismo dia.
    function rol() {
      return autenticado() ? request.auth.token.get('rol', '') : '';
    }

    function esEntrenador() {
      return rol() == 'entrenador';
    }

    function esNadador() {
      return rol() == 'nadador';
    }

    // A que perfil de nadador corresponde la cuenta. Vive en un documento y no
    // en el token porque es un dato que cambia y no tiene por que viajar en
    // cada peticion.
    function miNadadorId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        .data.get('nadadorId', '');
    }

    function soyEseNadador(nadadorId) {
      return esNadador()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && miNadadorId() == nadadorId;
    }

    // --- La puerta de consentimiento ------------------------------------

    // Un nadador menor sin consentimiento vigente no tiene datos aqui. Lo que
    // escriba se queda en su dispositivo, en la bandeja de salida, hasta que
    // su acudiente consienta. No queda bloqueado: queda retenido.
    //
    // Cuesta una lectura por escritura. A esta escala —decenas de nadadores—
    // es irrelevante, y desnormalizarlo para ahorrarla crearia la posibilidad
    // de que el estado de la puerta discrepe de si mismo en dos sitios.
    function tieneConsentimientoVigente(nadadorId) {
      return exists(/databases/$(database)/documents/consentimientos/$(nadadorId))
          && get(/databases/$(database)/documents/consentimientos/$(nadadorId))
               .data.get('vigente', false) == true;
    }

    // --- Planes ---------------------------------------------------------

    // Un plan aprobado o publicado es inmutable (FR-025). Ni el entrenador
    // puede escribir sobre el: editarlo crea una version nueva.
    function estadoEsInmutable(estado) {
      return estado == 'aprobado' || estado == 'publicado';
    }

    function planExistenteEsInmutable() {
      return resource != null && estadoEsInmutable(resource.data.estado);
    }

    // Lo que un nadador ve: solo lo publicado y asignado a el.
    //
    // Las dos condiciones importan por separado. Un borrador no es de nadie
    // todavia; un aprobado esta firmado pero no entregado —aprobar no es
    // entregar—; uno publicado sin asignar no es de este nadador.
    //
    // La asignacion es un documento aparte, uno por nadador, y no una lista
    // dentro del plan: ver la coleccion `asignaciones` mas abajo.
    function leEstaAsignado(planId) {
      return exists(/databases/$(database)/documents/asignaciones/$(planId + '|' + miNadadorId()));
    }

    function planEsDelNadador(planId) {
      return resource.data.estado == 'publicado' && leEstaAsignado(planId);
    }

    // Entregar: pasar de aprobado a publicado.
    //
    // Es la UNICA escritura permitida sobre un plan inmutable, y solo porque
    // **no toca su contenido**: cambia el estado y nada mas. La inmutabilidad
    // de FR-025 es sobre lo que el entrenador firmo —sesiones, series, version
    // de metodologia—, no sobre el hecho de haberlo entregado.
    //
    // Sin esto, publicar seria imposible: un plan aprobado no se puede
    // escribir, asi que nunca podria llegar a publicado. No salio antes porque
    // los planes vivian en memoria y nunca se guardaban.
    function cambiaElEstado() {
      return request.resource.data.estado != resource.data.estado;
    }

    // Firmar: borrador -> aprobado. Es el paso que el principio IV reserva al
    // entrenador. Puede traer consigo la version de metodologia y la fecha,
    // que es justo lo que el sello estampa.
    function esLaAprobacion() {
      return resource.data.estado == 'borrador'
          && request.resource.data.estado == 'aprobado';
    }

    function esLaEntrega() {
      return resource.data.estado == 'aprobado'
          && request.resource.data.estado == 'publicado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
    }

    match /planes/{planId} {
      allow read: if esEntrenador()
                  || (esNadador()
                      && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                      && planEsDelNadador(planId));

      // Crear: solo el entrenador, y solo en estado borrador.
      allow create: if esEntrenador()
                    && request.resource.data.estado == 'borrador';

      // Actualizar. El estado solo avanza por su camino y nunca se salta un
      // paso: borrador -> aprobado -> publicado.
      //
      // Que un borrador pudiera saltar directo a publicado lo destapo una
      // prueba al escribir esta regla. Habria dejado llegar a un nadador un
      // plan que el entrenador nunca firmo, y la firma es exactamente lo que
      // el principio IV no delega.
      //
      // Un nadador no mueve un plan a ningun estado, en ningun caso.
      allow update: if esEntrenador()
                    && (
                      (!cambiaElEstado() && !planExistenteEsInmutable())
                      || esLaAprobacion()
                      || esLaEntrega()
                    );

      allow delete: if esEntrenador() && !planExistenteEsInmutable();

      // Sesiones del plan: se leen con el plan y se escriben con el plan.
      match /sesiones/{sesionId} {
        function elPlan() {
          return get(/databases/$(database)/documents/planes/$(planId)).data;
        }

        allow read: if esEntrenador()
                    || (esNadador()
                        && elPlan().estado == 'publicado'
                        && leEstaAsignado(planId));

        allow write: if esEntrenador() && !estadoEsInmutable(elPlan().estado);
      }
    }

    // --- Asignaciones ----------------------------------------------------
    //
    // A quien se le entrego un plan. Una por nadador, con identificador
    // determinista `planId|nadadorId`, de modo que entregar dos veces escribe
    // el mismo documento y no duplica nada.
    //
    // **Aqui vive la puerta de publicacion** (FR-013). Y aqui es donde se
    // puede vivir: con una asignacion por nadador, la regla comprueba SU
    // consentimiento con un solo `get()`. Con la lista dentro del plan haria
    // falta recorrerla, y el lenguaje de reglas no tiene bucles, asi que la
    // puerta se habria quedado sin poder hacerse cumplir en el servidor.
    match /asignaciones/{asignacionId} {
      allow read: if esEntrenador()
                  || (esNadador()
                      && resource.data.nadadorId == miNadadorId());

      allow create: if esEntrenador()
                    && asignacionId == request.resource.data.planId + '|'
                                     + request.resource.data.nadadorId
                    && tieneConsentimientoVigente(request.resource.data.nadadorId);

      // Reasignar no se edita: se borra y se vuelve a crear, que pasa otra vez
      // por la puerta. Permitir un update dejaria cambiar el nadadorId de una
      // asignacion ya concedida sin volver a comprobar su consentimiento.
      allow update: if false;

      // Retirar un plan es del entrenador. No borra los registros que el
      // nadador ya envio: eso es suyo.
      allow delete: if esEntrenador();
    }

    // --- Nadadores ------------------------------------------------------

    match /nadadores/{nadadorId} {
      allow read: if esEntrenador() || soyEseNadador(nadadorId);
      allow write: if esEntrenador();
    }

    // --- Registros del nadador ------------------------------------------
    //
    // La respuesta del nadador a una sesion. Coleccion aparte del plan a
    // proposito: un plan aprobado es inmutable y lo que el nadador escribe no
    // lo toca.
    //
    // La feature 003 dejo aqui una limitacion declarada: las reglas no
    // distinguian a un nadador de otro porque no habia identidad. Queda
    // cerrada. No hizo falta migrar nada, porque cada registro ya llevaba su
    // nadadorId.
    match /registros/{registroId} {
      // El entrenador lee los de su comunidad. **No los escribe**: lo que el
      // nadador responde es su carga interna, no la del entrenador. Es un
      // cambio deliberado respecto de la 003, donde era lo unico permitido.
      allow read: if esEntrenador() || soyEseNadador(resource.data.nadadorId);

      allow create: if soyEseNadador(request.resource.data.nadadorId)
                    && tieneConsentimientoVigente(request.resource.data.nadadorId);

      allow update: if soyEseNadador(resource.data.nadadorId)
                    && soyEseNadador(request.resource.data.nadadorId)
                    && tieneConsentimientoVigente(resource.data.nadadorId);

      // Un registro no se borra desde el cliente. El derecho al borrado del
      // principio V se ejerce por la via del servidor, que puede dejar
      // constancia de que se ejercio.
      allow delete: if false;
    }

    // --- Consentimientos y solicitudes -----------------------------------
    //
    // **Ninguna escritura del cliente.** Ni la del entrenador. La fecha la
    // pone el servidor (D5) y el canje lo hace el servidor (D4); si el cliente
    // pudiera escribir aqui, las dos garantias serian declaraciones suyas.
    match /consentimientos/{nadadorId} {
      allow read: if esEntrenador() || soyEseNadador(nadadorId);
      allow write: if false;

      match /historial/{consentimientoId} {
        allow read: if esEntrenador() || soyEseNadador(nadadorId);
        allow write: if false;
      }
    }

    match /solicitudes/{solicitudId} {
      // El entrenador ve en que estado va. El token en claro no esta aqui:
      // solo su resumen, asi que leer esta coleccion no permite fabricar un
      // enlace valido (garantia C4).
      allow read: if esEntrenador();
      allow write: if false;
    }

    // --- Peticiones de plan (feature 008) --------------------------------
    //
    // **No confundir con `solicitudes`**, que son las de consentimiento de la
    // feature 004. Dos cosas distintas con el mismo nombre en la misma base es
    // como se escribe una regla contra la coleccion equivocada, y estas reglas
    // guardan datos de un menor. Por eso esta se llama distinto (decision D2).
    //
    // **El identificador del documento es el del nadador.** Esa es la pieza
    // que convierte «una peticion abierta a la vez» en algo que la regla puede
    // comprobar: con un identificador aleatorio ninguna regla podria contar
    // las abiertas, y el limite viviria solo en la pantalla.
    match /peticionesDePlan/{nadadorId} {

      // Abierta = esperando o en revision. Un documento recien creado todavia
      // no tiene estado —lo pone el servidor— y cuenta como abierto.
      function estaAbierta(datos) {
        return datos.get('estado', 'esperando') in ['esperando', 'enRevision'];
      }

      allow read: if esEntrenador() || soyEseNadador(nadadorId);

      // Una peticion recien mandada: **solo manda**, nada mas. Ni estado, ni
      // fecha de envio, ni plan, ni fecha de respuesta. Un cliente que pudiera
      // escribir su propio estado podria aprobarse su propia peticion (P13).
      //
      // Y la puerta del menor (P9): la bandeja del dispositivo ya lo retiene,
      // y esto es lo que lo sostiene cuando el dispositivo miente.
      function mandaLaSuya() {
        return soyEseNadador(nadadorId)
            && request.resource.data.nadadorId == nadadorId
            && request.resource.data.keys().hasOnly(['nadadorId', 'respuestas'])
            && tieneConsentimientoVigente(nadadorId);
      }

      allow create: if mandaLaSuya();

      allow update: if
            // El nadador reutiliza su documento cuando la anterior ya se
            // cerro. Es la misma escritura que un `create`, sobre un documento
            // que existe: **el documento se llama como el, asi que no hay otro
            // donde ponerla**. El servidor ya archivo la cerrada en
            // `historial`, asi que no se pierde lo que pidio (P12).
            (mandaLaSuya() && !estaAbierta(resource.data))

            // Lo unico que el entrenador cambia desde el cliente es abrirla.
            // Cerrar —aprobar o rechazar— pasa por el servidor, que es quien
            // pone la fecha y quien archiva: si el cliente pudiera, la fecha
            // seria una declaracion suya.
            || (esEntrenador()
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['estado'])
                && resource.data.get('estado', 'esperando') == 'esperando'
                && request.resource.data.estado == 'enRevision');

      // Nadie borra una peticion desde el cliente. El nadador que se
      // arrepiente se lo dice a su entrenador, que la rechaza; borrarla
      // dejaria sin rastro lo que se pidio.
      allow delete: if false;

      // El historial lo escribe el servidor al cerrar. Se lee igual que el
      // documento del que cuelga.
      match /historial/{peticionId} {
        allow read: if esEntrenador() || soyEseNadador(nadadorId);
        allow write: if false;
      }
    }

    // --- Vinculo cuenta <-> perfil de nadador ----------------------------

    match /usuarios/{uid} {
      allow read: if esEntrenador() || (autenticado() && request.auth.uid == uid);
      // Lo escribe el servidor al asociar un perfil. Si el cliente pudiera,
      // cualquiera se declararia dueno del perfil de otro y leeria sus planes.
      allow write: if false;
    }

    // --- Propuestas de ejercicio y glosario -----------------------------

    match /propuestasEjercicio/{propuestaId} {
      allow read, write: if esEntrenador();
    }

    match /glosario/{terminoId} {
      allow read, write: if esEntrenador();
    }

    // --- Todo lo demas --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
